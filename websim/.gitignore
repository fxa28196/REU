# --- dependencies / build outputs -------------------------------------------
node_modules/
dist/
build/
coverage/
.vite/
*.tsbuildinfo

# --- generated pipeline assets (rebuilt from scripts + java-exporter) --------
pipeline/out/

# --- curated validation working set payload (plan §5.3, §10 item 3) ----------
# The MANIFEST (working-set.manifest.json) is committed; the ~40 MB of archived
# CSVs it describes is NOT. Committing the payload has a repo-size implication
# that is the user's call, and no git-lfs is configured here. Materialise a local
# copy with `tsx pipeline/scripts/verify-working-set.ts --fetch`.
validation/working-set/data/

# --- plan Q4: git-ignored LOCAL RAW encampment path --------------------------
# Raw encampment coordinates/inc_ids live ONLY here and never enter git or any
# public asset. Public builds use node-snapped + salted-hash assets; the deploy
# job greps published assets for raw coordinates and raw inc_ids.
pipeline/local-raw/

# --- java-exporter compile output (sources + fixtures ARE tracked) -----------
# `build-and-dump.ps1` javac's into out/; the .tsv fixtures under
# pipeline/java-exporter/fixtures/ are deliberately NOT ignored -- they are the
# reproducibility evidence behind docs/DR-S1-geodesic.md and the CI parity test.
pipeline/java-exporter/out/
pipeline/java-exporter/out-world/
pipeline/java-exporter/out-csv/
pipeline/java-exporter/out-tie/
# certified Geography/ sources are recompiled into websim (never into Geography/bin)
pipeline/java-exporter/geo-classes/
# javac/java @argfiles regenerated by run-export.ps1 / dump-*.ps1 (machine-specific
# absolute paths, so committing one would break every other machine). Listed
# explicitly AND covered by the two globs below: a new dumper adds a new pair of
# argfiles, and the glob means nobody has to remember to come back here.
pipeline/java-exporter/classpath.txt
pipeline/java-exporter/javac-args.txt
pipeline/java-exporter/javac-exporter-args.txt
pipeline/java-exporter/javac-world-args.txt
pipeline/java-exporter/javac-tie-args.txt
pipeline/java-exporter/java-run-args.txt
pipeline/java-exporter/java-world-run-args.txt
pipeline/java-exporter/java-tie-run-args.txt
pipeline/java-exporter/javac-*-args.txt
pipeline/java-exporter/java-*-run-args.txt
pipeline/java-exporter/geo-sources.txt

# --- misc --------------------------------------------------------------------
*.log
.DS_Store
