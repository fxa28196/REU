{
  "name": "websim",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Browser-native TypeScript port + web UI of the wildfire shelter ABM (see docs/IMPLEMENTATION_PLAN.md). The Java/Repast model stays the certified instrument.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "engine",
    "pipeline",
    "app",
    "validation"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:strict": "tsx tools/test-strict.ts",
    "test:browser": "vitest run --config engine/vitest.browser.config.ts",
    "gate:browser": "tsx tools/browser-gate.ts",
    "axe": "tsx tools/axe-gate.ts",
    "typecheck": "npm run typecheck --workspaces && tsc -p tools --noEmit",
    "lint": "eslint .",
    "lint:claims": "tsx tools/lint-claims.ts",
    "check:scratch": "tsx tools/check-scratch.ts",
    "deploy-check": "tsx tools/deploy-check.ts",
    "ci": "npm run gate:browser -- --probe && npm run typecheck && npm run lint && npm test && npm run check:scratch && npm run lint:claims && npm run gate:browser"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "@vitest/browser": "3.2.7",
    "axe-core": "^4.12.1",
    "eslint": "^9.17.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "playwright": "1.56.1",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.19.0",
    "vitest": "^3.2.4"
  }
}
