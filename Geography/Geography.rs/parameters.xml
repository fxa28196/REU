<?xml version="1.0" encoding="UTF-8" ?>
<parameters>
	<parameter name="numAgents" displayName="Number of Agents" type="int"
		defaultValue="100"
		isReadOnly="false"
		converter="repast.simphony.parameter.StringConverterFactory$IntConverter"
	/>
	<parameter name="randomSeed" displayName="Default Random Seed" type="int"
		defaultValue="__NULL__"
		isReadOnly="false"
		converter="repast.simphony.parameter.StringConverterFactory$IntConverter"
	/>
	<!-- V13 (docs/science/VARIABLES.md): simulated minutes per schedule tick.
	     Modeling decision, pre-registration candidate - not a literature value. -->
	<parameter name="minutesPerTick" displayName="Simulated minutes per tick" type="double"
		defaultValue="1.0"
		isReadOnly="false"
		converter="repast.simphony.parameter.StringConverterFactory$DoubleConverter"
	/>
	<!-- V10 (docs/science/VARIABLES.md): comfortable walking speed, m/s.
	     Default 1.30 m/s within measured ranges of Bohannon 1997
	     (Age and Ageing 26(1):15-19, doi:10.1093/ageing/26.1.15).
	     PROVISIONAL for the unhoused population; declared sweep axis. -->
	<parameter name="walkingSpeedMps" displayName="Walking speed (m/s)" type="double"
		defaultValue="1.30"
		isReadOnly="false"
		converter="repast.simphony.parameter.StringConverterFactory$DoubleConverter"
	/>
	<!-- Metric replacement for the stock demo's 0.002-degree arrival radius
	     (anisotropic: ~222 m N-S vs ~156 m E-W at Portland's latitude).
	     Modeling threshold, documented in docs/science/VARIABLES.md. -->
	<parameter name="shelterArrivalDistanceM" displayName="Shelter arrival radius (m)" type="double"
		defaultValue="200.0"
		isReadOnly="false"
		converter="repast.simphony.parameter.StringConverterFactory$DoubleConverter"
	/>
	<!-- AUDIT.md issue #1: residents shelter in place at their encampment until
	     local PM2.5 first reaches this threshold, then evacuate. Default 55.5 =
	     the EPA "Unhealthy" AQI PM2.5 breakpoint (sourced; DATA_SOURCES D9). -->
	<parameter name="evacuationThresholdUgM3" displayName="Evacuation PM2.5 threshold (ug/m3)" type="double"
		defaultValue="55.5"
		isReadOnly="false"
		converter="repast.simphony.parameter.StringConverterFactory$DoubleConverter"
	/>
	<!-- Length of the simulated event window in hours (Sept 7-19 2020 = ~312 h).
	     Run ends at simulationHours*60/minutesPerTick, capped at the smoke-field
	     length. Anchors the end-of-run export. -->
	<parameter name="simulationHours" displayName="Simulated event hours" type="int"
		defaultValue="312"
		isReadOnly="false"
		converter="repast.simphony.parameter.StringConverterFactory$IntConverter"
	/>
	<!-- Final study scenarios (09-DECISIONS.md; only two exist by design):
	     0 = A, the real September-2020 shelter placement (DATA_SOURCES D1);
	     1 = B, the same total capacity relocated to the street-network p-median
	         optimum (scripts/optimize_shelters.py). B is a THEORETICAL siting
	         optimum, not a policy recommendation - it ignores building
	         availability, ownership, zoning, staffing and ADA access. -->
	<parameter name="scenarioCode" displayName="Scenario (0=current placement, 1=optimized)" type="int"
		defaultValue="0"
		isReadOnly="false"
		converter="repast.simphony.parameter.StringConverterFactory$IntConverter"
	/>
	<!-- Heterogeneous residents (V18-V22, V10 revised): per-agent age, sex,
	     mobility limitation, asthma, COPD and walking speed sampled from the
	     sourced distributions in docs/science/phase2-human-agents/01-POPULATION.md
	     and 03-MOVEMENT.md. 0 = every resident walks at the run-wide
	     walkingSpeedMps and carries no attributes (the archived baseline). -->
	<parameter name="enableHeterogeneity" displayName="Heterogeneous residents (0/1)" type="int"
		defaultValue="0"
		isReadOnly="false"
		converter="repast.simphony.parameter.StringConverterFactory$IntConverter"
	/>
	<!-- Honour the real shelter opening dates (OCC 2020-09-10, CJ 2020-09-11;
	     DATA_SOURCES D1). 0 = every shelter open from tick 0, which is
	     counterfactual and is the source of blocking assumption A-02. -->
	<parameter name="respectShelterOpeningDates" displayName="Honour shelter opening dates (0/1)" type="int"
		defaultValue="0"
		isReadOnly="false"
		converter="repast.simphony.parameter.StringConverterFactory$IntConverter"
	/>
</parameters>
